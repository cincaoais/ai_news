# Template for .env -- copy this file to `.env` (which is gitignored, never
# committed) and fill in the real values. Real environment variables always
# override .env values.
#
# .env is only used for LOCAL runs on your dev machine. The production paths
# do not read it: the Claude Code Routine gets these as cloud-environment
# variables, and the GitHub Actions fallback gets them as repository secrets.

# From @BotFather after /newbot (looks like 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Your personal chat id. Don't know it? Fill in the token above, send your
# bot /start on Telegram, then run:  python scripts/get_chat_id.py
TELEGRAM_CHAT_ID=PASTE_YOUR_CHAT_ID_HERE
