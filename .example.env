# Template for .env -- copy this file to `.env` (which is gitignored, never
# committed) and fill in the real values. Real environment variables always
# override .env values.
#
# .env is only used for LOCAL runs on your dev machine. The production path
# does not read it: the GitHub Actions scheduler gets these as repository
# secrets (DEEPSEEK_API_KEY, TELEGRAM_BOT_TOKEN, TELEGRAM_CHAT_ID).

# From https://platform.deepseek.com (API keys section). Powers the editorial
# step (deepseek-chat). Pay-as-you-go -- a daily digest costs a fraction of a
# cent; keep a small balance topped up.
DEEPSEEK_API_KEY=PASTE_YOUR_DEEPSEEK_API_KEY_HERE

# From @BotFather after /newbot (looks like 123456:ABC-DEF...)
TELEGRAM_BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Your personal chat id. Don't know it? Fill in the token above, send your
# bot /start on Telegram, then run:  python scripts/get_chat_id.py
TELEGRAM_CHAT_ID=PASTE_YOUR_CHAT_ID_HERE
